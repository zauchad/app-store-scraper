# ============================================================
#  Market Research Intelligence Platform - configuration
#  Copy to `.env` and fill in. All values have safe defaults.
# ============================================================

# --- Database ---------------------------------------------------------------
# Local dev (zero setup): leave empty -> falls back to a local SQLite file.
# Production (free): paste your Supabase connection string, e.g.
#   postgresql+psycopg2://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# --- LLM (Intelligence Layer) ----------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Use the forward-compatible alias (gemini-2.5-flash 404s for new API projects).
# Free tier is capped per day, so `all` twice/day may still 429 -> use a key pool
# (GEMINI_API_KEYS below), run LLM steps once/day, or upgrade the plan.
# Alternatives: gemini-flash-lite-latest (faster/higher limits), gemini-2.0-flash.
GEMINI_MODEL=gemini-flash-latest
# Optional: pool of keys to multiply the daily free-tier limit. When one key's
# daily quota is hit, the app rotates to the next. Use keys from SEPARATE Google
# Cloud projects for independent quotas (e.g. 3 keys => ~60 req/day).
# GEMINI_API_KEYS takes precedence over GEMINI_API_KEY if set.
GEMINI_API_KEYS=
# Provider abstraction: currently "gemini" (openai/anthropic can be added later)
LLM_PROVIDER=gemini
# Pace + resilience for rate limits (429). Min seconds between calls + retries.
LLM_MIN_INTERVAL_SECONDS=4.0
LLM_MAX_RETRIES=3

# --- Scraper ----------------------------------------------------------------
# Storefront to scan (us = highest review volume = best LLM signal)
STORE_COUNTRY=us
# How many top apps per category to ingest (max 200 from Apple RSS)
TOP_N_APPS=50
# Charts to pull: topfree,toppaid,topgrossing
CHARTS=topfree,topgrossing
# Skip these genre IDs (6014 = Games, excluded by default: capital-heavy)
EXCLUDED_GENRE_IDS=6014
# Max review pages per app (50 reviews/page). Kept low to stay polite/fast.
REVIEW_PAGES_PER_APP=5

# --- Review provider (MODE A: real review text) ----------------------------
# "rss"      -> free legacy feed (mostly empty in 2026; kept as fallback)
# "rapidapi" -> hosted App Store reviews API (cheap, reliable, no browser)
REVIEW_PROVIDER=rss
MAX_REVIEWS_PER_APP=100
# Fill these only if REVIEW_PROVIDER=rapidapi. Pick any App Store reviews API on
# RapidAPI, then paste its host + a URL template using {app_id} {country} {page}.
RAPIDAPI_KEY=
RAPIDAPI_HOST=
# Example (adapt to the API you subscribe to):
# RAPIDAPI_REVIEWS_URL=https://{host}/reviews?app_id={app_id}&country={country}&page={page}
RAPIDAPI_REVIEWS_URL=

# --- Business / Marketing assumptions --------------------------------------
# Your monthly marketing budget in PLN (used for reach & feasibility math)
MARKETING_BUDGET_PLN=7500
# USD -> PLN FX used to convert CPI benchmarks
USD_PLN_RATE=4.0

# --- Deep-dive (Level 2 LLM) ------------------------------------------------
# How many top-opportunity categories get the expensive LLM synthesis per run
DEEP_DIVE_TOP_K=5

# --- Retention -------------------------------------------------------------
# OFF by default: keep ALL raw daily snapshots forever. Set true to downsample
# snapshots older than RETENTION_DAILY_DAYS to one-per-app-per-week.
RETENTION_ENABLED=false
RETENTION_DAILY_DAYS=60

# --- Micro-niche discovery (Level 3) ---------------------------------------
# Free search-interest proxy from App Store autocomplete: "proxy" or "none".
VOLUME_PROVIDER=proxy
# Weight of search-interest vs app-engagement in keyword demand (0..1).
DEMAND_SEARCH_WEIGHT=0.5
# Auto-discovery: top categories to drill + keywords generated per category.
DISCOVER_TOP_CATEGORIES=5
DISCOVER_KEYWORDS_PER_CATEGORY=12

# --- Apple Ads search popularity (oficjalny sygnał 5-100; DARMOWE konto) ---
# 1. Załóż darmowe konto Apple Ads (nie wymaga wydawania na reklamy).
# 2. Account Settings -> API -> wgraj klucz publiczny, skopiuj identyfikatory.
# 3. Ustaw VOLUME_PROVIDER=asa. Przy braku/limicie danych automatyczny
#    fallback do darmowego proxy (autocomplete).
# VOLUME_PROVIDER=asa
# ASA_CLIENT_ID=SEARCHADS.xxxxx
# ASA_TEAM_ID=SEARCHADS.xxxxx
# ASA_KEY_ID=xxxxxxxx-xxxx-...
# ASA_PRIVATE_KEY=/path/to/private-key.pem
# ASA_ORG_ID=1234567
# Endpoint popularity (Apple przebudowuje ten obszar; szablon z {term}/{country}):
# ASA_POPULARITY_URL=https://api.searchads.apple.com/api/v5/...?query={term}
# ASA_POPULARITY_BODY=

# --- Reddit demand mining (DARMOWE, 2 min konfiguracji) ---
# 1. Wejdź na https://www.reddit.com/prefs/apps -> "create app" -> typ "script".
# 2. Skopiuj client id (pod nazwą apki) i secret.
# Sygnał "is there an app for..." - popyt oddolny, zanim widać go w App Store.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# --- Dostawa digestu (Slack i/lub e-mail; oba darmowe, oba opcjonalne) ---
# Slack: utwórz Incoming Webhook (api.slack.com/messaging/webhooks).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxx
# E-mail przez Gmail: włącz 2FA -> App Passwords -> hasło aplikacji.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=twoj@gmail.com
# SMTP_PASSWORD=haslo-aplikacji
# EMAIL_FROM=twoj@gmail.com
# EMAIL_TO=twoj@gmail.com
