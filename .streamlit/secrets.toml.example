# Streamlit Community Cloud secrets template.
# In the Streamlit Cloud UI: App -> Settings -> Secrets, paste the filled version.
# Top-level keys are ALSO exposed as environment variables, so pydantic-settings
# in src/config.py picks them up automatically (no code change needed).

# Supabase Postgres (use the IPv4 POOLER connection string; see README).
DATABASE_URL = "postgresql+psycopg2://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Google Gemini (free tier): https://aistudio.google.com/apikey
# Comma-separated pool, or a single key.
GEMINI_API_KEYS = "your_gemini_key,optional_second_key"
GEMINI_MODEL = "gemini-flash-latest"

# Business assumptions
MARKETING_BUDGET_PLN = "7500"
STORE_COUNTRY = "us"

# Optional: MODE A real reviews via RapidAPI
# REVIEW_PROVIDER = "rapidapi"
# RAPIDAPI_KEY = "your_rapidapi_key"
# RAPIDAPI_HOST = "host.p.rapidapi.com"
# RAPIDAPI_REVIEWS_URL = "https://host.p.rapidapi.com/reviews?app_id={app_id}&country={country}&page={page}"
